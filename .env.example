# Base URL for the FastAPI backend (no trailing slash). In dev, Vite can proxy /api — see vite.config.ts
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:5000
# Company slug sent as X-Company-Id on every API request
VITE_COMPANY_ID=yada

# Production builds (`npm run build`, Azure Static Web Apps) use `.env.production`.
# Do not leave VITE_API_BASE_URL=/api there — that calls the static host and returns 404.

# Azure App Service runtime override (via /config.js, no rebuild):
# API_BASE_URL=https://your-api.azurewebsites.net/api
# COMPANY_ID=yada
